# Copiar a .env.development (y .env.production en el servidor) y completar.
# TODO lo de este archivo es PÚBLICO: se incrusta en el JavaScript que descarga
# cualquier visitante. Nunca poner aquí secretos ni claves privadas.

# API: base de rutas y de su WebSocket de versiones.
VITE_API_URL=http://localhost:4000/api/v1
# Origen de la API: imágenes de evidencias y trazas enlazadas en RUM.
VITE_API_ORIGIN=http://localhost:4000
# Debe coincidir con APP_KEY de la API (cabecera x-app-key).
VITE_APP_KEY=123
# VITE_APP_VERSION lo genera el build: no definirla a mano.

# Monitoreo RUM de OpenObserve (opcional, solo producción). El token es el
# público de ingesta de RUM, no una credencial de administración.
# Vacío = sin monitoreo.
VITE_OPENOBSERVE_SITE=
VITE_OPENOBSERVE_CLIENT_TOKEN=
VITE_OPENOBSERVE_ORG=default
