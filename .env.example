NEXT_PUBLIC_URL_PREFIX=/api
NEXT_PUBLIC_URL_VERSION=/v1
NEXT_PUBLIC_URL_API_RAW=http://localhost:4000
NEXT_PUBLIC_URL_API=$NEXT_PUBLIC_URL_API_RAW$NEXT_PUBLIC_URL_PREFIX$NEXT_PUBLIC_URL_VERSION

NEXT_PUBLIC_APP_KEY=123

# OpenObserve RUM (solo producción): host sin https://, token público de RUM y organización.
NEXT_PUBLIC_OPENOBSERVE_SITE=logs.comportarte.com
NEXT_PUBLIC_OPENOBSERVE_CLIENT_TOKEN=rum...
NEXT_PUBLIC_OPENOBSERVE_ORG=default
