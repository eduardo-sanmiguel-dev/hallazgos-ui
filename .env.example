# Browser-visible configuration. Never put private keys or server secrets here.
VITE_API_URL=http://localhost:4000/api/v1
VITE_API_ORIGIN=http://localhost:4000
VITE_APP_KEY=
# Build generates VITE_APP_VERSION; do not set it manually.

# Optional browser monitoring (public ingestion credentials only).
VITE_OPENOBSERVE_SITE=
VITE_OPENOBSERVE_CLIENT_TOKEN=
VITE_OPENOBSERVE_ORG=default
