# Copiar a e2e/.env.e2e (ignorado por git) y completar.
# Usuario exclusivo de pruebas en la base de DESARROLLO. Copia los mismos
# valores al .env.development de hallazgos-api: al levantar la API en
# desarrollo se crea solo si no existe (ver e2e/README.md).
E2E_EMAIL=e2e@hallazgos.test
E2E_PASSWORD=
# Opcional: URL del UI (por defecto http://localhost:3000).
# E2E_BASE_URL=http://localhost:3000
